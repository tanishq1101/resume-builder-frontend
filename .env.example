VITE_API_BASE=http://localhost:5001
VITE_FRONTEND_URL=http://localhost:5173

# Firebase Web App config (Firebase Console > Project settings > Your apps > Web app)
# These are public client identifiers, not secrets — but still keep them out of source control
# since they're specific to your project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
